{
  "name": "@voidr/capture-desktop",
  "productName": "Voidr Capture",
  "version": "0.1.0",
  "private": true,
  "description": "Voidr capture control plane for Web and Mobile",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/index.cjs",
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "build:main": "tsup --config tsup.config.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "tsup --config tsup.config.ts --watch",
    "dev:renderer": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev": "npm run build:main && concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"wait-on tcp:4173 && cross-env VOIDR_CAPTURE_DEV_SERVER_URL=http://127.0.0.1:4173 electron .\"",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.5",
    "@voidr/capture-contracts": "*",
    "@voidr/capture-design-system": "*",
    "@voidr/capture-kernel": "*",
    "@voidr/capture-presentation": "*",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "43.3.0",
    "lucide-react": "^0.536.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4",
    "zod": "^4.4.3"
  }
}
