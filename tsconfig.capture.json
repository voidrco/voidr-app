{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@voidr/capture-contracts": ["./packages/capture-contracts/src/index.ts"],
      "@voidr/capture-kernel": ["./packages/capture-kernel/src/index.ts"],
      "@voidr/capture-presentation": ["./packages/capture-presentation/src/index.ts"],
      "@voidr/capture-design-system": ["./packages/capture-design-system/src/index.tsx"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  }
}
