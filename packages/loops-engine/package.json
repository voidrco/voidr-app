{
  "name": "@voidr/loops-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/core.mjs && node --import tsx tests/target.mjs && node --import tsx tests/timing.mjs && node --import tsx tests/resilience.mjs"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "tsup": "^8.5.0",
    "typescript": "5.9.3",
    "@types/node": "^24.0.0"
  }
}
